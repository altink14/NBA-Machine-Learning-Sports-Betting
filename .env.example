# =============================================================================
# Betting Buddy - backend (FastAPI) environment template
# =============================================================================
# Copy to `.env` for local development and fill in real values.
# In production set these in the Render / Railway service dashboard.
# `.env` is gitignored; this template is committed. NEVER put real values here.
#
# Derived from `grep -rn "os.environ\|os.getenv" --include=*.py` and
# cross-checked against the "Env inventory" section of DEPLOY.md.
# =============================================================================

# --- Database bootstrap -----------------------------------------------------
# REQUIRED IN PRODUCTION. URL of a .tar.gz containing Data/*.sqlite. On boot
# bootstrap_db.py downloads and extracts it if Data/TeamData.sqlite is absent.
# If unset the API still starts, but every stats endpoint returns empty.
# Not needed locally (the databases already exist on disk).
# Used by: bootstrap_db.py
DB_SNAPSHOT_URL=https://github.com/<owner>/<repo>/releases/download/db-snapshot-v1/db-snapshot.tar.gz

# --- CORS -------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Comma-separated list of allowed browser origins,
# no trailing slashes. Defaults to
# "http://localhost:3000,http://127.0.0.1:3000" so a fresh checkout works
# unconfigured. Set this to the Vercel URL once the frontend is deployed.
# Used by: main_api.py (CORSMiddleware)
CORS_ORIGINS=https://your-frontend.vercel.app

# --- API authentication -----------------------------------------------------
# OPTIONAL. When set, requests to the PROTECTED paths must carry an `X-API-Key`
# header matching this value. Protected paths are an explicit allowlist:
#     /predictions, /api/parlay/evaluate, /api/line-movements
# Everything else stays keyless ON PURPOSE. The reference site is public and is
# fetched directly from the browser by ~18 client components, so a key there
# would either 401 the whole site or have to ship to every visitor. Those
# endpoints are defended by CORS + rate limiting instead.
#
# /, /health, /api/prediction-log and /api/stats/* are always open.
# /api/prediction-log is deliberately public - it is the public grading ledger
# behind /track-record, fetched straight from the browser.
#
# Set the SAME value as NBA_API_KEY in the frontend, which attaches the header
# from its server-side route handlers only.
# Used by: main_api.py (require_api_key dependency)
API_KEY=

# --- Rate limiting (per client IP) ------------------------------------------
# OPTIONAL. slowapi rate-limit strings. Defaults shown.
#
# NOTE: these are only correct per-visitor if uvicorn trusts the platform's
# X-Forwarded-For. The Dockerfile passes --forwarded-allow-ips="*" for this
# reason; without it every request behind Render/Railway looks like one IP and
# RATE_LIMIT_GLOBAL becomes a single shared bucket for your whole userbase.
# Used by: main_api.py
RATE_LIMIT_DEFAULT=60/minute
# Per-IP ceiling across ALL endpoints. Without this, a crawler could pull
# RATE_LIMIT_DEFAULT from each of the 42 routes (~2,500 req/min).
RATE_LIMIT_GLOBAL=240/minute
# /predictions and /api/parlay/evaluate - live scraping plus model inference.
RATE_LIMIT_EXPENSIVE=10/minute
# The five routes that call stats.nba.com at request time (shot charts, player
# stats, player detail). One inbound request becomes one outbound NBA call, so
# sustained abuse gets THIS SERVER's IP throttled or banned by stats.nba.com,
# which breaks the site for everyone and is not fixed by a redeploy.
RATE_LIMIT_UPSTREAM=20/minute

# --- Data pipeline ----------------------------------------------------------
# OPTIONAL. Directory for cached stats.nba.com responses.
# Defaults to "Data/nba_cache". Used by: src/Utils/nba_stats_client.py
NBA_CACHE_DIR=Data/nba_cache

# --- Odds provider ----------------------------------------------------------
# OPTIONAL. Sportsbook used for odds/predictions. Listed in DEPLOY.md and set
# in render.yaml, but currently NOT read anywhere in Python - the sportsbook
# is passed per-request. Kept here so the deploy docs stay truthful; remove
# once either the code reads it or the docs drop it.
DEFAULT_SPORTSBOOK=fanduel

# OPTIONAL. Listed in DEPLOY.md but not read by any Python in this repo -
# live odds come from sbrscrape, which needs no key. Placeholder only.
ODDS_API_KEY=

# --- Runtime ----------------------------------------------------------------
# Set automatically by Render / Railway (Dockerfile defaults it to 8000).
# Do not set manually in production.
# PORT=8000

# =============================================================================
# Present in some local .env files but referenced by NO code in this repo.
# Do NOT set these in production unless something starts using them.
# =============================================================================
# ADMIN_SECRET             no reader in this repo
# GEMINI_API_KEY           AI chat lives in the frontend, not here
# RAPIDAPI_NBA_KEY         no reader in this repo
# SCHEDULE_HOUR            no reader; the 9 AM run is a Windows scheduled task
# SCHEDULE_MINUTE          no reader; same as above
# SUPABASE_URL             no reader in this repo
# SUPABASE_SERVICE_ROLE_KEY  no reader in this repo
